# ==============================================================================
# SmartSarabun (องค์การบริหารส่วนตำบลดอยงาม) - Frontend Environment Variables
# ==============================================================================

# 1. NextAuth Secret (สำหรับเซสชันและระบบรักษาความปลอดภัย แนะนำให้สร้างคีย์สุ่ม 32 ตัวอักษร)
# ตัวอย่าง: openssl rand -base64 32
AUTH_SECRET="smart-sarabun-secure-secret-key-2569-change-in-production"
NEXTAUTH_SECRET="smart-sarabun-secure-secret-key-2569-change-in-production"

# 2. Supabase Cloud Integration (ทางเลือก ข - เชื่อมต่อฐานข้อมูลคลาวด์แบบ Serverless)
# รับค่าได้จาก Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# 3. (Optional) Custom Backend API URL (หากมีการเชื่อมต่อกับ NestJS ในอนาคต)
# NEXT_PUBLIC_API_URL="http://localhost:4000/api"
